<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Tối ưu Group Class - Teky 2026</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .gradient-bg { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); }
    </style>
</head>
<body class="bg-slate-50 min-h-screen">

    <nav class="gradient-bg text-white p-4 shadow-lg">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold tracking-tight">TEKY HOLDINGS - REGION DASHBOARD</h1>
            <span class="bg-blue-400/30 px-3 py-1 rounded-full text-xs font-medium">Báo cáo Tháng 1 & 2 / 2026</span>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto p-6">
        <div class="mb-8">
            <h2 class="text-2xl font-bold text-slate-800">Kế hoạch Gom Nhóm Buổi 4 & 9</h2>
            <p class="text-slate-500 font-medium">Phân tích hiệu quả tối ưu nhân sự và chi phí giảng dạy toàn miền.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <p class="text-slate-400 text-sm font-bold uppercase tracking-wider">Tổng buổi dự kiến</p>
                <div class="flex items-end justify-between mt-2">
                    <span class="text-4xl font-extrabold text-slate-900">289</span>
                    <span class="text-slate-400 mb-1 font-medium text-sm">Buổi học</span>
                </div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 border-l-4 border-l-emerald-500">
                <p class="text-slate-400 text-sm font-bold uppercase tracking-wider text-emerald-600">GV Đứng chính</p>
                <div class="flex items-end justify-between mt-2">
                    <span class="text-4xl font-extrabold text-emerald-600">130</span>
                    <span class="text-emerald-500 mb-1 font-medium text-sm">Giữ lại</span>
                </div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 border-l-4 border-l-orange-500">
                <p class="text-slate-400 text-sm font-bold uppercase tracking-wider text-orange-600">Chuyển sang TA</p>
                <div class="flex items-end justify-between mt-2">
                    <span class="text-4xl font-extrabold text-orange-500">159</span>
                    <span class="text-orange-500 mb-1 font-medium text-sm">Admin quản lý</span>
                </div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 border-l-4 border-l-blue-600">
                <p class="text-slate-400 text-sm font-bold uppercase tracking-wider text-blue-600">Tỷ lệ tối ưu</p>
                <div class="flex items-end justify-between mt-2">
                    <span class="text-4xl font-extrabold text-blue-600">55%</span>
                    <span class="text-blue-500 mb-1 font-medium text-sm">Quỹ lương</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
            <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-slate-100 text-center">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center justify-center">
                    So sánh Tối ưu theo Cơ sở
                </h3>
                <div class="h-[400px]">
                    <canvas id="barChart"></canvas>
                </div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <h3 class="text-lg font-bold text-slate-800 mb-6">Cơ cấu Lớp học Toàn Miền</h3>
                <div class="h-[300px]">
                    <canvas id="doughnutChart"></canvas>
                </div>
                <div class="mt-6 space-y-3">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-slate-500">Lớp có GV Chính:</span>
                        <span class="font-bold text-emerald-600">45%</span>
                    </div>
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-slate-500">Lớp gom (TA hỗ trợ):</span>
                        <span class="font-bold text-orange-500">55%</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="p-6 border-b border-slate-50 flex justify-between items-center">
                <h3 class="text-lg font-bold text-slate-800">Chi tiết Phân bổ Nhân sự (Buổi 4-9)</h3>
                <span class="text-xs text-slate-400">*Dữ liệu đã khớp với File Tổng Kết</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="p-4 font-bold text-slate-600 text-sm uppercase">Cơ sở</th>
                            <th class="p-4 font-bold text-slate-600 text-sm uppercase text-center">Tổng buổi</th>
                            <th class="p-4 font-bold text-emerald-600 text-sm uppercase text-center">Có GV Chính</th>
                            <th class="p-4 font-bold text-orange-600 text-sm uppercase text-center">Admin (TA)</th>
                            <th class="p-4 font-bold text-blue-600 text-sm uppercase text-center">% Tối ưu</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr class="hover:bg-blue-50/50 transition-colors">
                            <td class="p-4 font-semibold text-slate-700">Quận 7 Him Lam</td>
                            <td class="p-4 text-center text-slate-600">70</td>
                            <td class="p-4 text-center font-bold text-emerald-600">32</td>
                            <td class="p-4 text-center font-bold text-orange-500">38</td>
                            <td class="p-4 text-center font-bold text-blue-600 italic">54.3%</td>
                        </tr>
                        <tr class="hover:bg-blue-50/50 transition-colors">
                            <td class="p-4 font-semibold text-slate-700">Bình Thạnh</td>
                            <td class="p-4 text-center text-slate-600">54</td>
                            <td class="p-4 text-center font-bold text-emerald-600">23</td>
                            <td class="p-4 text-center font-bold text-orange-500">31</td>
                            <td class="p-4 text-center font-bold text-blue-600 italic">57.4%</td>
                        </tr>
                        <tr class="hover:bg-blue-50/50 transition-colors">
                            <td class="p-4 font-semibold text-slate-700">Tân Phú</td>
                            <td class="p-4 text-center text-slate-600">41</td>
                            <td class="p-4 text-center font-bold text-emerald-600">21</td>
                            <td class="p-4 text-center font-bold text-orange-500">20</td>
                            <td class="p-4 text-center font-bold text-blue-600 italic">48.8%</td>
                        </tr>
                        <tr class="hover:bg-blue-50/50 transition-colors bg-blue-50/30">
                            <td class="p-4 font-bold text-slate-800">Gò Vấp</td>
                            <td class="p-4 text-center text-slate-600 font-bold">38</td>
                            <td class="p-4 text-center font-bold text-emerald-600">15</td>
                            <td class="p-4 text-center font-bold text-orange-500 underline">23</td>
                            <td class="p-4 text-center font-bold text-blue-600 italic">60.5%</td>
                        </tr>
                        <tr class="hover:bg-blue-50/50 transition-colors bg-blue-50/30">
                            <td class="p-4 font-bold text-slate-800">Quận 3</td>
                            <td class="p-4 text-center text-slate-600 font-bold">33</td>
                            <td class="p-4 text-center font-bold text-emerald-600">11</td>
                            <td class="p-4 text-center font-bold text-orange-500 underline">22</td>
                            <td class="p-4 text-center font-bold text-blue-600 italic text-lg">66.7%</td>
                        </tr>
                        <tr class="hover:bg-blue-50/50 transition-colors">
                            <td class="p-4 font-semibold text-slate-700">Thủ Dầu Một</td>
                            <td class="p-4 text-center text-slate-600">30</td>
                            <td class="p-4 text-center font-bold text-emerald-600">18</td>
                            <td class="p-4 text-center font-bold text-orange-500">12</td>
                            <td class="p-4 text-center font-bold text-blue-600 italic">40.0%</td>
                        </tr>
                        <tr class="hover:bg-blue-50/50 transition-colors">
                            <td class="p-4 font-semibold text-slate-700">Bình Tân</td>
                            <td class="p-4 text-center text-slate-600">23</td>
                            <td class="p-4 text-center font-bold text-emerald-600">10</td>
                            <td class="p-4 text-center font-bold text-orange-500">13</td>
                            <td class="p-4 text-center font-bold text-blue-600 italic">56.5%</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="mt-12 py-8 text-center text-slate-400 text-sm">
        Dashboard được tự động khởi tạo dựa trên dữ liệu kế hoạch 2026.
    </footer>

    <script>
        // Data for Bar Chart
        const barCtx = document.getElementById('barChart').getContext('2d');
        new Chart(barCtx, {
            type: 'bar',
            data: {
                labels: ['Q7 Him Lam', 'Bình Thạnh', 'Tân Phú', 'Gò Vấp', 'Quận 3', 'TDM', 'Bình Tân'],
                datasets: [
                    {
                        label: 'GV Chính (Đứng lớp)',
                        data: [32, 23, 21, 15, 11, 18, 10],
                        backgroundColor: '#10b981',
                        borderRadius: 6
                    },
                    {
                        label: 'Chuyển thành TA (Admin)',
                        data: [38, 31, 20, 23, 22, 12, 13],
                        backgroundColor: '#f97316',
                        borderRadius: 6
                    }
                ]
            },
            options: {
                maintainAspectRatio: false,
                scales: {
                    x: { stacked: true, grid: { display: false } },
                    y: { stacked: true, grid: { borderDash: [2] } }
                },
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // Data for Doughnut Chart
        const doughnutCtx = document.getElementById('doughnutChart').getContext('2d');
        new Chart(doughnutCtx, {
            type: 'doughnut',
            data: {
                labels: ['GV Chính', 'Chuyển sang TA'],
                datasets: [{
                    data: [130, 159],
                    backgroundColor: ['#10b981', '#f97316'],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                }
            }
        });
    </script>
</body>
</html>
